probabilistic query: inference winner;
program:

// I need everything to be u7 because the final choice has type u7
u7 winner;

main (){
    u7 final;
    query alice(final, 0);
    winner = final;
}

alice(u7 &final, u7 counter){
    u7 choice, coin_flip; 
    choice = uniform(1, 3);
     
    if (counter + choice >= 8) {
        // I won
        final = 1;
    } else {
        query bob(final, counter + choice);

        
        coin_flip = 1 {999 : 1000} 0;
        if (coin_flip){
            observe final == 1;
        } else {}
        

        /*
        if (final != 1){
            coin_flip = 1 {1 : 1000} 0;
            observe coin_flip;
        } else {}
        */
    }
}

bob(u7 &final, u7 counter){
    u7 choice, coin_flip; 
    choice = uniform(1, 3);
     
    if (counter + choice >= 8) {
        final = 2;
    } else {
        query alice(final, counter + choice);

        coin_flip = 1 {999 : 1000} 0;
        if (coin_flip){
            observe final == 2;
        } else {}

        /*
        if (final != 2){
            coin_flip = 1 {1 : 1000} 0;
            observe coin_flip;
        } else {}
        */
    }
}