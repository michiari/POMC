probabilistic query: inference [|crash];
program:
u2[10] ego_lane, npc_lane;
u4 time;
bool crash;

scenario() {
  ego_lane[0] = 1; // ego is in lane 1 at time 0
  npc_lane[0] = 3; // npc is in lane 3 at time 0
  crash = false;
  time = 0;
  while (time < 9 && !crash) {
    ego();
    npc();
    time = time + 1;
    crash = crash || ego_lane[time] == npc_lane[time];
  }
}

ego() {
  u2 npc_lane_sim;
  query npc_sim(npc_lane_sim);
  if (npc_lane_sim != ego_lane[time]) {
    ego_lane[time + 1] = ego_lane[time];
  } else {
    if (ego_lane[time] < 3) {
      ego_lane[time + 1] = ego_lane[time] + 1;
    } else {
      ego_lane[time + 1] = ego_lane[time] - 1;
    }
  }
}

npc() {
  bool change_lane, distracted;
  u2 new_lane;
  change_lane = true {1:2} false;
  distracted = true {1:5} false;
  npc_impl(change_lane, distracted, new_lane);
  npc_lane[time + 1] = new_lane;
}

npc_sim(u2 &new_lane) {
  bool change_lane, distracted;
  change_lane = true {1:2} false;
  distracted = true {1:10} false;
  npc_impl(change_lane, distracted, new_lane);
}

npc_impl(bool change_lane, bool distracted, u2 &new_lane) {
  if (change_lane && npc_lane[time] > 1 && (distracted || ego_lane[time] != npc_lane[time] - 1)) {
    new_lane = npc_lane[time] - 1;
  } else {
    new_lane = npc_lane[time];
  }
}
