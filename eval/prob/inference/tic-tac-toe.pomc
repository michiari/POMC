probabilistic query: inference choice;
program:
/*  
    0 = non assigned - '?' in the .wppl program
    1 = O (player 1)
    2 = X (player 2)
    Initial Condition: 
    | O  |    |     |
    |    |    |  X  |
    |    |    |     |
Reference: A. Stuhlmueller, N.D. Goodman, Reasoning about Reasoning by Nested Conditioning: Modeling Theory of Mind with Probabilistic Programs, Cognitive Systems Research 2014.
*/ 

// I need everything to be u4 because the final choice has type u4
u4 choice;

main (){
    u4 row_choice, column_choice;
    u4[3] upper, middle, lower;
    upper[0u4] = 1u4;
	upper[1u4] = 0u4;
	upper[2u4] = 0u4;
    middle[0u4] = 0u4;
	middle[1u4] = 0u4;
	middle[2u4] = 2u4;
    lower[0u4] = 0u4;
	lower[1u4] = 0u4;
	lower[2u4] = 0u4;
    // O plays first
    query act(1u4, row_choice, column_choice, lower, middle, upper);
    choice = column_choice + 3 * row_choice;
}

move_prior(u4 &row_choice, u4 &column_choice, u4[3] lower, u4[3] middle, u4[3] upper) {

    row_choice = 0u4 {1u4 : 3u4} 1u4 {1u4: 3u4} 2u4;
    column_choice = 0u4 {1u4 : 3u4} 1u4 {1u4: 3u4} 2u4;

    // observe that the choice is feasible
    if (row_choice == 0u4) {
        observe upper[column_choice] == 0u4;
    } else {
        if (row_choice == 1u4) {
            observe middle[column_choice] == 0u4;
        } else {
            observe lower[column_choice] == 0u4;
        }
    }
}

// return the winner (0 if nobody)
compute_winner(u4 &final_winner, u4[3] lower, u4[3] middle, u4[3] upper) {
    if (upper[0u4] == upper[1u4] && upper[1u4] == upper[2u4] && upper[0u4] > 0u4) {
        final_winner = upper[0u4]; // first row
    } else {
        if (middle[0u4] == middle[1u4] && middle[1u4] == middle[2u4] && middle[0u4] > 0u4) {
            final_winner = middle[0u4]; // second row
        } else {
            if (lower[0u4] == lower[1u4] && lower[1u4] == lower[2u4] && lower[0u4] > 0u4) {
                final_winner = lower[0u4]; // third row
            } else {
                if (upper[0u4] == middle[0u4] && middle[0u4] == lower[0u4] && upper[0u4] > 0u4) {
                    final_winner = upper[0u4]; // first column
                } else {
                    if (upper[1u4] == middle[1u4] && middle[1u4] == lower[1u4] && upper[1u4] > 0u4) {
                        final_winner = upper[1u4]; // second column
                    } else {
                        if (upper[2u4] == middle[2u4] && middle[2u4] == lower[2u4] && upper[2u4] > 0u4) {
                            final_winner = upper[2u4]; // third column
                        } else {
                            if (upper[0u4] == middle[1u4] && middle[1u4] == lower[2u4] && upper[0u4] > 0u4) {
                                final_winner = upper[0u4]; //diag1
                            } else {
                                if (upper[2u4] == middle[1u4] && middle[1u4] == lower[0u4] && upper[2u4] > 0u4) {
                                    final_winner = upper[2u4]; //diag2
                                } else {
                                    final_winner = 0u4;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// in the original .wppl program, they use e, which is an irrational number not supported by our tool. 
// Also, e^-10 is a too small number, and creates various numerical issues..
// Instead, I use the following scores: WIN=6, DRAW=3, LOSE=0. 
// I use the following rational approximations: e^6 ~ 2824/7, e^4 ~ 703/35.
// I use the normalization factor e^6.
utility(u4 current_player, u4 final_winner) {
    bool coin_flip;
    u50 utility;

    if (final_winner == current_player) {
        utility = 2824/7; // factor(6)
    } else {
        if (final_winner == 0u4) {
        utility = 703/35; // factor(3)
        } else {
            utility = 1; // factor(0)
        }
    }

    // factor statement simulated through a hard conditioning statement
    coin_flip = 1u1 {utility : 2824/7} 0u1;
    observe coin_flip;
}

act(u4 current_player, u4 &row_choice, u4 &column_choice, u4[3] lower, u4[3] middle, u4[3] upper) {
    u4 final_winner;

    // sample a choice from the priori
    query move_prior(row_choice, column_choice, lower, middle, upper);
    
    simulate(current_player, row_choice, column_choice, lower, middle, upper);

    compute_winner(final_winner, lower, middle, upper);
    utility(current_player, final_winner);
    // returning row_choice and column_choice - the choice of the player
}

simulate(u4 current_player, u4 row_choice, u4 column_choice, u4[3] &lower, u4[3] &middle, u4[3] &upper) {
    bool is_not_complete;
    u4 other_player;
    u4 final_winner;
    u4 otherPlayerRowChoice, otherPlayerColumnChoice; 

    //transition
    if (row_choice == 0u4) {
        upper[column_choice] = current_player;
    } else {
        if (row_choice == 1u4) {
            middle[column_choice] = current_player;
        } else {
            lower[column_choice] = current_player;
        }
    }

    // is there a final_winner or is the grid filled?
    is_not_complete = upper[0u4] == 0u4 || upper[1u4] == 0u4 || upper[2u4] == 0u4 || middle[0u4] == 0u4 || middle[1u4] == 0u4 || middle[2u4] == 0u4 || lower[0u4] == 0u4 || lower[1u4] == 0u4 || lower[2u4] == 0u4;
    compute_winner(final_winner, lower, middle, upper);

    // if nobody has won and there is another turn to play, let's pass the turn
    if (final_winner == 0u4 && is_not_complete) {    
        if (current_player == 1u4) {
            other_player = 2u4;
        } else {
            other_player = 1u4;
        }

        query act(other_player, otherPlayerRowChoice, otherPlayerColumnChoice, lower, middle, upper);
        simulate(other_player, otherPlayerRowChoice, otherPlayerColumnChoice, lower, middle, upper);
    } else {}
}