probabilistic query: inference finalLoc;

program:
u4 n;
bool finalLoc;

main() {
  n = 10;
  query alice(finalLoc);
}

alice(bool &prior_alice) {
    bool bob_choice;
    // sample according to the prior (0.55)
    prior_alice = 1 {11 : 20} 0;
    n = n - 1u4;
    query bob(bob_choice);
    observe prior_alice == bob_choice;
}

bob(bool &prior_bob) {
    bool alice_choice;
    // sample according to the prior (0.55)
    prior_bob = 1 {11 : 20} 0;
    // check whether recursing again
    if (n > 0) {
        query alice(alice_choice);
        observe prior_bob == alice_choice;
    } else {}
}
