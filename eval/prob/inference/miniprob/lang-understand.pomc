probabilistic query: inference finalState;

/* Encoding:
'allSprouted' = 2; 'someSprouted' = 1; 'noneSprouted' = 0.
State of world = how many sprouted? (ranging from 0 to 3).
finalState is the state of the world learnt by the listener.
*/

program:
u4 finalState;

main() {
  query listener(1, finalState);
}

listener(u2 sentence, u4 &state){
    bool literal;
    u2 sentence1;
    state = uniform(0,3);
    // decide probabilistically whether taking it literally (p = 0.50)
    literal = 1 {1 : 9} 0;

    if (literal){
        observe (sentence == 0 && state == 0) || (sentence == 1 && state > 0) || (sentence == 2 && state == 3);
    } else {
        query speaker(sentence1, state);
        observe sentence == sentence1;
    }
}

speaker(u2 &sentence, u4 state){
    u4 state1, state2, state3;
    sentence = uniform(0,2);

    // we use two calls to a literal listener to model temperature alpha = 2 in the .wppl original program
    query listener(sentence, state1);
    query listener(sentence, state2);
    observe state == state1 && state == state2;
}
